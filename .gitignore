# MATLAB temporary, autosave, build, and cache files
*.asv
*.autosave
*.m~
*~
slprj/
codegen/
*.mex*
*.mlappinstall

# Generated Stage-1 numerical artifacts remain local.
/results/stage_1/**

# Accepted per-stage PNG/FIG pairs are canonical project assets.
/plots/stage_1/**
!/plots/stage_1/
!/plots/stage_1/png/
!/plots/stage_1/png/*.png
!/plots/stage_1/fig/
!/plots/stage_1/fig/*.fig
!/plots/stage_1/diagnostics/
!/plots/stage_1/diagnostics/active_set_gate2/
!/plots/stage_1/diagnostics/active_set_gate2/png/
!/plots/stage_1/diagnostics/active_set_gate2/png/*.png
!/plots/stage_1/diagnostics/active_set_gate2/fig/
!/plots/stage_1/diagnostics/active_set_gate2/fig/*.fig

# Logs, coverage, and temporary outputs
*.log
*.tmp
*.temp
coverage/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# License-sensitive/project-local Kao source and native-reference cache
/third_party/kao_optimal_preparation/local_cache/

# Editor and IDE artifacts
.vscode/
.idea/
*.swp
*.swo
